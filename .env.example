# Copy this file to .env at the repo root (pnpm/Prisma read it via dotenv)
# and to apps/web/.env.local for Next.js. See DEPLOYMENT.md for how to get
# each value on the free tiers.

# --- Database (Neon or Supabase Postgres, free tier) ------------------------
# Pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:5432/educore?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection string, used only by `prisma migrate`.
DIRECT_URL="postgresql://user:password@host:5432/educore?sslmode=require"

# --- Auth.js ------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
# Phase 6 (two-factor sign-in). Optional: encrypts 2FA secrets and signs backup
# codes / "remember this device". If unset, a key is derived from NEXTAUTH_SECRET.
# Decide ONCE, before anyone turns 2FA on: changing it (or rotating NEXTAUTH_SECRET
# while this is unset) means everyone's 2FA must be reset by an admin.
TWO_FACTOR_KEY=""
# Break-glass ONLY: "1" stops enforcing 2FA for everyone (e.g. if a 2FA fault locks
# admins out). Logged loudly. Remove it again straight away.
TWO_FACTOR_BREAK_GLASS=""
# Phase 7 (student health records). REQUIRED to switch health records on: encrypts
# every pupil's health profile at rest. Generate with: openssl rand -base64 32
# Set it ONCE (Sensitive, Production + Preview) and never change or lose it after
# the first record is saved — records encrypted with the old key can't be read.
# Unset: the Clinic and parents' Health pages say health records aren't set up.
HEALTH_DATA_KEY=""
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth providers — omit to disable them (email/password still works)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_ENTRA_ID_CLIENT_ID=""
MICROSOFT_ENTRA_ID_CLIENT_SECRET=""
MICROSOFT_ENTRA_ID_ISSUER=""

# --- Multi-tenancy --------------------------------------------------------
# Comma-separated list of "root" domains — a request whose Host header is one
# of these (or a subdomain of one) is tenant-resolved by subdomain. Anything
# else is treated as a candidate custom domain lookup.
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000,educore.app"

# --- File storage: Supabase Storage (Phase 5 — worksheets, submitted work) --
# Private bucket "educore-uploads" (created by packages/db/supabase/0024_storage_bucket.sql).
# SUPABASE_URL is public; SUPABASE_SERVICE_ROLE_KEY is a SECRET (Supabase →
# Project Settings → API Keys → service_role / secret key). Mark it Sensitive in
# Vercel. Without it, assignments still work but file attachments/uploads are off.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET="educore-uploads"
# Each school's share of file storage in MB (assignment worksheets + handed-in work). Default 500.
STORAGE_QUOTA_MB_PER_SCHOOL=500

# --- Background jobs (Inngest) — CSV imports run here ----------------------
# Easiest: install the Inngest integration from the Vercel Marketplace and it
# sets both for you. Locally, run `npx inngest-cli@latest dev` and set
# INNGEST_DEV=1 instead of real keys.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Email (Resend free tier — 100/day) ----------------------------------
# Used for "set your password" invites and "you have a new message" emails
# (Phase 4.4; the message itself is never emailed). Leave empty and EduCore
# shows the admin a one-time invite link to share (WhatsApp/SMS) instead, and
# message notifications stay in-app (unread counts) only.
# Until you verify your own domain in Resend, EMAIL_FROM must be
# "EduCore <onboarding@resend.dev>" and mail only reaches your own address.
# Also needed for "Forgot password?" emails (Phase 6.1); without it that page says email isn't available yet.
RESEND_API_KEY=""
EMAIL_FROM="EduCore <no-reply@educore.app>"

# --- School fees online (Paystack, milestone 3.3) -------------------------
# Paystack dashboard → Settings → API Keys & Webhooks (Test mode): the
# Test Secret Key (sk_test_…). Server-only; never NEXT_PUBLIC_. Leave empty
# and parents simply don't see "Pay online" (bursary payments still work).
# Also set the Test Webhook URL in Paystack to
#   https://<your-domain>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=""

# --- Payments (Stripe, test mode — EduCore's own subscriptions, Phase 4) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- Rate limiting (Upstash Redis free tier; omit to fall back to in-memory) -
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Error monitoring (Sentry free tier) ---------------------------------
SENTRY_DSN=""
