// EduCore — Phase 0 data model
//
// ASSUMPTION (stated explicitly, per project working rules): User.email is
// globally unique across the whole platform, not just per tenant. This keeps
// Auth.js's adapter contract (getUserByEmail) simple and correct. A person
// who needs access to more than one school needs a distinct login email for
// now — cross-tenant identity linking is a fast-follow, not a Phase 0 need.
// PLATFORM_ADMIN users have tenantId = null (they sit above tenant isolation,
// architecture rule #1); every other role always has a non-null tenantId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  PLATFORM_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
}

enum Plan {
  FREE_TRIAL
  STARTER
  STANDARD
  PREMIUM
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  TERMLY
  ANNUAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  STRIPE
  POS
  CHEQUE
  PAYSTACK
}

enum PaymentKind {
  PAYMENT
  REVERSAL
}

enum BillingRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AnnouncementAudience {
  SCHOOL
  CLASS
  ROLE
}

enum ReportCardStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum ImportKind {
  STUDENTS
  STAFF
  CLASSES
  PAYMENTS
}

enum ImportStatus {
  VALIDATED
  QUEUED
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

// ---------------------------------------------------------------------------
// Platform-level (not tenant-owned)
// ---------------------------------------------------------------------------

model Tenant {
  id                    String       @id @default(cuid())
  name                  String
  slug                  String       @unique
  subdomain             String       @unique
  customDomain          String?      @unique
  logoUrl               String?
  plan                  Plan         @default(FREE_TRIAL)
  status                TenantStatus @default(ACTIVE)
  suspendedAt           DateTime?
  suspendedReason       String?
  settings              Json         @default("{}")
  branding              Json         @default("{}")
  /// When a school admin hid the setup checklist (milestone 1.4). The ONLY
  /// column a school's own session may write on this table — see migration 0008.
  onboardingDismissedAt DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  users                User[]
  academicYears        AcademicYear[]
  classes              ClassGrade[]
  sections             Section[]
  subjects             Subject[]
  classSectionSubjects ClassSectionSubject[]
  students             Student[]
  guardians            Guardian[]
  studentGuardians     StudentGuardian[]
  teachers             Teacher[]
  staff                Staff[]
  attendance           Attendance[]
  assessmentTypes      AssessmentType[]
  assessments          Assessment[]
  marks                Mark[]
  reportCards          ReportCard[]
  timetableEntries     TimetableEntry[]
  announcements        Announcement[]
  feeTypes             FeeType[]
  discounts            Discount[]
  studentDiscounts     StudentDiscount[]
  feeSignups           FeeSignup[]
  feeStructures        FeeStructure[]
  invoices             Invoice[]
  invoiceLines         InvoiceLine[]
  payments             Payment[]
  messageThreads       MessageThread[]
  messages             Message[]
  auditLogs            AuditLog[]
  subscription         Subscription?
  platformInvoices     PlatformInvoice[]
  logo                 TenantLogo?
  platformPayments     PlatformPayment[]
  importJobs           ImportJob[]
  terms                Term[]
  timetablePeriods     TimetablePeriod[]
  gradeBands           GradeBand[]
  academicSettings     AcademicSettings?
  resultPublications   ResultPublication[]
  reportCardRuns       ReportCardRun[]
  numberSequences      NumberSequence[]
  billingRuns          BillingRun[]
  onlinePayments       OnlinePayment[]
  impersonations       ImpersonationSession[]

  @@map("tenants")
}

/// Platform-level billing record. One per tenant. Only PLATFORM_ADMIN and the
/// owning tenant's SCHOOL_ADMIN may read it.
enum PlatformInvoiceStatus {
  OPEN
  PAID
  VOID
}

enum PlatformPaymentKind {
  CHECKOUT
  RENEWAL
}

enum PlatformPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  ABANDONED
  NEEDS_REVIEW
}

/// EduCore's own invoice to a school (Phase 4.2): one per billing month.
/// Platform-level; amounts in kobo; amount = students × unit price (CHECK).
model PlatformInvoice {
  id             String                @id @default(cuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number         String                @unique @default(dbgenerated("('ECI-'::text || lpad((nextval('platform_invoice_no_seq'::regclass))::text, 6, '0'::text))"))
  plan           Plan
  periodStart    DateTime
  periodEnd      DateTime
  students       Int
  unitPriceMinor Int
  amountMinor    Int
  currency       String                @default("NGN")
  status         PlatformInvoiceStatus @default(OPEN)
  paidAt         DateTime?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt

  payments PlatformPayment[]

  @@index([tenantId, periodStart])
  @@map("platform_invoices")
}

/// One attempt to collect a PlatformInvoice (checkout or saved-card renewal).
model PlatformPayment {
  id            String                @id @default(cuid())
  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoice       PlatformInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reference     String                @unique
  kind          PlatformPaymentKind
  amountMinor   Int
  currency      String                @default("NGN")
  status        PlatformPaymentStatus @default(PENDING)
  channel       String?
  message       String?
  initiatedById String?
  createdAt     DateTime              @default(now())
  verifiedAt    DateTime?

  @@index([invoiceId])
  @@map("platform_payments")
}

/// A school's logo (branding). Platform-level: written and served by the server only.
model TenantLogo {
  tenantId    String   @id
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  data        Bytes
  contentType String
  sizeBytes   Int
  sha256      String
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("tenant_logos")
}

/// Plan catalogue (Phase 4.1) — platform-level, edited in the platform console.
/// Price is per active student per month, minor units (kobo).
model PlanDefinition {
  code        Plan     @id
  name        String
  priceMinor  Int      @default(0)
  maxStudents Int?
  modules     String[] @default([])
  isPublic    Boolean  @default(true)
  updatedAt   DateTime @default(now()) @updatedAt
  updatedById String?

  @@map("plans")
}

model Subscription {
  id                        String             @id @default(cuid())
  tenantId                  String             @unique
  tenant                    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stripeCustomerId          String?            @unique
  stripeSubscriptionId      String?            @unique
  plan                      Plan               @default(FREE_TRIAL)
  status                    SubscriptionStatus @default(TRIALING)
  currentPeriodEnd          DateTime?
  cancelAtPeriodEnd         Boolean            @default(false)
  /// Phase 4.2 (Paystack): downgrade scheduled for the next renewal.
  pendingPlan               Plan?
  billingEmail              String?
  /// Reusable Paystack card authorization. Server-only: never sent to a browser or written to an audit entry.
  paystackAuthorizationCode String?
  paystackCustomerCode      String?
  cardBrand                 String?
  cardLast4                 String?
  cardExpiry                String?
  failedAttempts            Int                @default(0)
  nextChargeAt              DateTime?
  lastChargeError           String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Identity (Auth.js-compatible)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  // Nullable ONLY for PLATFORM_ADMIN — see assumption note at top of file.
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String    @unique
  emailVerified DateTime?
  name          String
  image         String?
  role          Role
  passwordHash  String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]

  teacherProfile  Teacher?
  staffProfile    Staff?
  studentProfile  Student?
  guardianProfile Guardian?

  attendanceMarked      Attendance[]           @relation("AttendanceMarkedBy")
  marksEntered          Mark[]                 @relation("MarkEnteredBy")
  announcementsMade     Announcement[]         @relation("AnnouncementPublishedBy")
  threadsStarted        MessageThread[]        @relation("ThreadCreatedBy")
  messagesSent          Message[]              @relation("MessageSender")
  threadParticipants    ThreadParticipant[]
  auditLogEntries       AuditLog[]             @relation("AuditActor")
  importJobs            ImportJob[]            @relation("ImportCreatedBy")
  resultsPublished      ResultPublication[]    @relation("ResultPublishedBy")
  reportCardRuns        ReportCardRun[]        @relation("ReportCardRunBy")
  invoicesCreated       Invoice[]              @relation("InvoiceCreatedBy")
  paymentsRecorded      Payment[]              @relation("PaymentRecordedBy")
  billingRuns           BillingRun[]           @relation("BillingRunBy")
  onlinePayments        OnlinePayment[]        @relation("OnlinePaymentPayer")
  impersonationsStarted ImpersonationSession[] @relation("ImpersonationBy")
  impersonatedIn        ImpersonationSession[] @relation("ImpersonationOf")

  @@index([tenantId])
  @@map("users")
}

/// OAuth account links (Google / Microsoft). Auth.js Adapter shape.
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Academic structure (tenant-owned)
// ---------------------------------------------------------------------------

model AcademicYear {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // e.g. "2026/2027"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  classes          ClassGrade[]
  terms            Term[]
  timetableEntries TimetableEntry[]
  students         Student[]
  attendance       Attendance[]
  assessments      Assessment[]
  reportCards      ReportCard[]
  feeStructures    FeeStructure[]
  invoices         Invoice[]
  studentDiscounts StudentDiscount[]

  // Also enforced in migration 0006 (not expressible in Prisma schema):
  //   - partial unique index: at most one isActive = true per tenant
  //   - CHECK (endDate > startDate)
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("academic_years")
}

model ClassGrade {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String // e.g. "Grade 5"
  order          Int          @default(0)

  sections           Section[]
  announcements      Announcement[]
  students           Student[]
  feeStructures      FeeStructure[]
  timetableEntries   TimetableEntry[]
  resultPublications ResultPublication[]

  @@unique([tenantId, academicYearId, name])
  @@index([tenantId])
  @@index([tenantId, academicYearId])
  @@map("class_grades")
}

model Section {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId       String
  class         ClassGrade @relation(fields: [classId], references: [id], onDelete: Cascade)
  name          String // e.g. "A"
  capacity      Int?       @default(40)
  /// Optional form (class) teacher: takes the daily register and writes report-card comments (Phase 2).
  formTeacherId String?
  formTeacher   Teacher?   @relation("FormTeacher", fields: [formTeacherId], references: [id], onDelete: SetNull)

  students             Student[]
  classSectionSubjects ClassSectionSubject[]
  attendance           Attendance[]
  assessments          Assessment[]
  timetableEntries     TimetableEntry[]
  reportCardRuns       ReportCardRun[]

  // Also enforced in migration 0006: CHECK (capacity IS NULL OR capacity > 0)
  @@unique([tenantId, classId, name])
  @@index([tenantId])
  @@index([tenantId, classId])
  @@map("sections")
}

model Subject {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  code     String

  classSectionSubjects ClassSectionSubject[]
  assessments          Assessment[]
  timetableEntries     TimetableEntry[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("subjects")
}

/// Teacher-to-(section,subject) assignment.
model ClassSectionSubject {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sectionId, subjectId])
  @@index([tenantId])
  @@map("class_section_subjects")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model Student {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  admissionNo    String
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  gender         String?
  classId        String?
  class          ClassGrade?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  sectionId      String?
  section        Section?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  admissionDate  DateTime      @default(now())
  status         StudentStatus @default(ACTIVE)
  photoUrl       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  guardians      StudentGuardian[]
  attendance     Attendance[]
  marks          Mark[]
  reportCards    ReportCard[]
  invoices       Invoice[]
  discounts      StudentDiscount[]
  feeSignups     FeeSignup[]
  messageThreads MessageThread[]
  payments       Payment[]
  onlinePayments OnlinePayment[]

  @@unique([tenantId, admissionNo])
  @@index([tenantId])
  @@index([tenantId, classId, sectionId])
  @@map("students")
}

model Guardian {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String?
  occupation String?

  students StudentGuardian[]

  @@index([tenantId])
  @@map("guardians")
}

model StudentGuardian {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId   String
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationship String // FATHER, MOTHER, GUARDIAN, OTHER
  isPrimary    Boolean  @default(false)

  @@unique([tenantId, studentId, guardianId])
  @@index([tenantId])
  @@map("student_guardians")
}

model Teacher {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId    String
  qualification String?
  department    String?
  joiningDate   DateTime @default(now())

  classSectionSubjects ClassSectionSubject[]
  timetableEntries     TimetableEntry[]
  formSections         Section[]             @relation("FormTeacher")

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@map("teachers")
}

model Staff {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId  String
  designation String?
  department  String?
  joiningDate DateTime @default(now())

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@map("staff")
}

// ---------------------------------------------------------------------------
// Attendance, assessments, report cards
// ---------------------------------------------------------------------------

model Attendance {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String?
  sectionId      String?
  section        Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  date           DateTime         @db.Date
  status         AttendanceStatus
  markedById     String
  markedBy       User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt

  @@unique([tenantId, studentId, date])
  @@index([tenantId])
  @@index([tenantId, sectionId, date])
  @@map("attendance")
}

model AssessmentType {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// A score component, e.g. "CA1", "Exam" (Phase 2 decision: school-set components adding up to 100).
  name     String
  /// Maximum marks for this component, out of the subject's 100. Components add up to 100 (checked in the app).
  weight   Float  @default(100)
  order    Int    @default(0)

  assessments Assessment[]

  // Also enforced in migration 0009: CHECK (weight > 0 AND weight <= 100)
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("assessment_types")
}

model Assessment {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId   String
  academicYear     AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sectionId        String
  section          Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assessmentTypeId String
  assessmentType   AssessmentType @relation(fields: [assessmentTypeId], references: [id], onDelete: Cascade)
  /// Term the scores count toward (Phase 2.2). A term with assessments can't be deleted.
  termId           String
  term             Term           @relation(fields: [termId], references: [id], onDelete: Restrict)
  name             String
  /// What the assessment is marked out of; scaled to the component's weight (lib/results.ts).
  maxScore         Float          @default(100)
  date             DateTime       @db.Date

  marks Mark[]

  // One gradebook column per component, per subject, section and term.
  // Also enforced in migration 0011: CHECK (maxScore > 0)
  @@unique([tenantId, termId, sectionId, subjectId, assessmentTypeId])
  @@index([tenantId])
  @@map("assessments")
}

model Mark {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score        Float
  grade        String?
  remarks      String?
  enteredById  String
  enteredBy    User       @relation("MarkEnteredBy", fields: [enteredById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tenantId, assessmentId, studentId])
  @@index([tenantId])
  @@map("marks")
}

model ReportCard {
  id               String           @id @default(cuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId   String
  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  /// Term the card reports on (Phase 2.3; replaces the old free-text `term`).
  termId           String
  term             Term             @relation(fields: [termId], references: [id], onDelete: Restrict)
  templateConfig   Json             @default("{}")
  /// Reserved for stored PDFs (Supabase Storage) — unused: PDFs are drawn from `snapshot` on download.
  fileUrl          String?
  /// Form teacher's comment (written before generating).
  teacherComment   String?
  /// Principal / head's comment (school admins).
  principalComment String?
  /// Frozen contents of the card at generation time (versioned JSON, lib/report-card.ts).
  /// The PDF is always drawn from this, so a downloaded card never changes after generation.
  snapshot         Json?
  status           ReportCardStatus @default(PENDING)
  generatedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt

  @@unique([tenantId, studentId, termId])
  @@index([tenantId])
  @@map("report_cards")
}

// ---------------------------------------------------------------------------
// Timetable & communication
// ---------------------------------------------------------------------------

model TimetableEntry {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId        String
  class          ClassGrade   @relation(fields: [classId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  /// Year the lesson belongs to (Phase 2.4) — clash rules apply within a year.
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  dayOfWeek      Int // 0=Sunday .. 6=Saturday (school days Mon–Fri)
  /// TimetablePeriod.number
  period         Int
  /// Copied from the bell schedule when the lesson is saved (for quick display).
  startTime      String // "08:00"
  endTime        String // "08:45"
  room           String?

  // Clash rules, enforced in migration 0013 as well as in the app:
  //   - one lesson per section per slot (below)
  //   - a teacher in one place per slot per year (below)
  //   - a room in use once per slot per year (expression index on the normalised room name)
  @@unique([tenantId, sectionId, dayOfWeek, period])
  @@unique([tenantId, academicYearId, teacherId, dayOfWeek, period])
  @@index([tenantId])
  @@index([tenantId, sectionId, dayOfWeek])
  @@map("timetable_entries")
}

model Announcement {
  id              String               @id @default(cuid())
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String
  body            String
  audienceScope   AnnouncementAudience @default(SCHOOL)
  audienceClassId String?
  audienceRole    Role?
  audienceClass   ClassGrade?          @relation(fields: [audienceClassId], references: [id], onDelete: Cascade)
  isPinned        Boolean              @default(false)
  publishedById   String
  publishedBy     User                 @relation("AnnouncementPublishedBy", fields: [publishedById], references: [id])
  publishedAt     DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt

  @@index([tenantId])
  @@index([tenantId, publishedAt])
  @@index([tenantId, isPinned, publishedAt])
  @@map("announcements")
}

model MessageThread {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject       String
  studentId     String?
  student       Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?    @relation("ThreadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  participants ThreadParticipant[]
  messages     Message[]

  @@index([tenantId])
  @@index([tenantId, lastMessageAt])
  @@map("message_threads")
}

model ThreadParticipant {
  id         String        @id @default(cuid())
  threadId   String
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  joinedAt   DateTime      @default(now())

  @@unique([threadId, userId])
  @@index([userId])
  @@map("thread_participants")
}

model Message {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  threadId    String
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation("MessageSender", fields: [senderId], references: [id])
  body        String
  attachments Json          @default("[]")
  sentAt      DateTime      @default(now())

  @@index([tenantId])
  @@index([tenantId, threadId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Fees & payments
// ---------------------------------------------------------------------------

// "Fee items" in the UI (3.0). Optional items are billed only to students
// signed up for them that term; one-off items (e.g. admission fee) only on a
// student's first invoice that includes them.
model FeeType {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isOptional  Boolean @default(false)
  isOneOff    Boolean @default(false)
  isActive    Boolean @default(true)
  order       Int     @default(0)

  feeStructures FeeStructure[]
  discounts     Discount[]
  signups       FeeSignup[]
  invoiceLines  InvoiceLine[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("fee_types")
}

model FeeStructure {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String?
  class          ClassGrade?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  feeTypeId      String
  feeType        FeeType      @relation(fields: [feeTypeId], references: [id], onDelete: Cascade)
  // The fee schedule (3.0): one amount per item, class and term. Rows without
  // a term predate Phase 3 and are never billed.
  termId         String?
  term           Term?        @relation(fields: [termId], references: [id], onDelete: Restrict)
  amount         Decimal      @db.Decimal(12, 2)
  frequency      FeeFrequency @default(TERMLY)

  invoiceLines InvoiceLine[]

  @@unique([tenantId, termId, classId, feeTypeId])
  @@index([tenantId])
  @@index([tenantId, termId])
  @@map("fee_structures")
}

enum DiscountKind {
  PERCENT
  FIXED
}

// A school's named discounts (sibling 10%, staff child, scholarship). Value is
// a percentage (0–100] for PERCENT or an amount for FIXED; feeTypeId limits it
// to one fee item, otherwise it applies to the whole bill.
model Discount {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  kind      DiscountKind
  value     Decimal      @db.Decimal(12, 2)
  feeTypeId String?
  feeType   FeeType?     @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  students     StudentDiscount[]
  invoiceLines InvoiceLine[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("discounts")
}

// Who gets which discount: for one term, or the whole year (termId null).
// Uniqueness per (student, discount, year, term-or-year) is an expression
// index in migration 0014.
model StudentDiscount {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  discountId     String
  discount       Discount     @relation(fields: [discountId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId         String?
  term           Term?        @relation(fields: [termId], references: [id], onDelete: Restrict)
  note           String?
  createdAt      DateTime     @default(now())

  @@index([tenantId])
  @@index([tenantId, academicYearId])
  @@map("student_discounts")
}

// Optional fee items a student is signed up for in a term (bus, lunch…).
model FeeSignup {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeTypeId String
  feeType   FeeType  @relation(fields: [feeTypeId], references: [id], onDelete: Cascade)
  termId    String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, studentId, feeTypeId, termId])
  @@index([tenantId, termId])
  @@map("fee_signups")
}

// Phase 3.1: one live (not cancelled) invoice per student per term — a
// partial unique index in migration 0015. totalDue is the invoice total;
// amountPaid is the sum of its payments (net of reversals), updated in the
// same transaction as every payment. Balance = totalDue − amountPaid.
// OVERDUE is shown, not stored: ISSUED/PARTIALLY_PAID past dueDate.
model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId         String?
  term           Term?         @relation(fields: [termId], references: [id], onDelete: Restrict)
  invoiceNo      String
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(12, 2)
  totalDue       Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  currency       String        @default("NGN")
  cancelledAt    DateTime?
  cancelReason   String?
  billingRunId   String?
  billingRun     BillingRun?   @relation(fields: [billingRunId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  lines          InvoiceLine[]
  payments       Payment[]
  onlinePayments OnlinePayment[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId])
  @@index([tenantId, termId, status])
  @@index([tenantId, studentId])
  @@map("invoices")
}

// kind: FEE (≥ 0), DISCOUNT (≤ 0) or ADJUSTMENT (either sign) — CHECK in 0015.
model InvoiceLine {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  kind           String        @default("FEE")
  feeTypeId      String?
  feeType        FeeType?      @relation(fields: [feeTypeId], references: [id], onDelete: SetNull)
  discountId     String?
  discount       Discount?     @relation(fields: [discountId], references: [id], onDelete: SetNull)
  description    String
  amount         Decimal       @db.Decimal(12, 2)
  quantity       Int           @default(1)
  position       Int           @default(0)

  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@map("invoice_lines")
}

// Phase 3.2: append-only (the app role has no UPDATE/DELETE grant). A
// REVERSAL row (negative amount) undoes a PAYMENT, once (reversesId unique).
model Payment {
  id                    String         @id @default(cuid())
  tenantId              String
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId             String
  invoice               Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  studentId             String
  student               Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind                  PaymentKind    @default(PAYMENT)
  amount                Decimal        @db.Decimal(12, 2)
  method                PaymentMethod
  reference             String?
  receiptNo             String?
  note                  String?
  stripePaymentIntentId String?        @unique
  reversesId            String?        @unique
  reverses              Payment?       @relation("PaymentReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy            Payment?       @relation("PaymentReversal")
  recordedById          String?
  recordedBy            User?          @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  paidAt                DateTime       @default(now())
  createdAt             DateTime       @default(now())
  onlinePayment         OnlinePayment?

  @@index([tenantId])
  @@index([tenantId, paidAt])
  @@index([tenantId, invoiceId])
  @@index([tenantId, studentId])
  @@map("payments")
}

enum OnlinePaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  ABANDONED
  NEEDS_REVIEW
}

// Phase 3.3: one online checkout a parent started (Paystack). The provider
// reference is unique across all schools — it's how a webhook finds its
// school. SUCCEEDED only after server-side verification, and then linked to
// the one Payment it created (paymentId unique: never recorded twice).
model OnlinePayment {
  id         String              @id @default(cuid())
  tenantId   String
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId  String
  invoice    Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payerId    String?
  payer      User?               @relation("OnlinePaymentPayer", fields: [payerId], references: [id], onDelete: SetNull)
  provider   String              @default("paystack")
  reference  String              @unique
  amount     Decimal             @db.Decimal(12, 2)
  currency   String
  status     OnlinePaymentStatus @default(PENDING)
  channel    String?
  message    String?
  paymentId  String?             @unique
  payment    Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdAt  DateTime            @default(now())
  verifiedAt DateTime?

  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, status])
  @@map("online_payments")
}

// Per-school counters for invoice and receipt numbers (key e.g. "invoice:2026").
model NumberSequence {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key      String
  value    Int    @default(0)

  @@id([tenantId, key])
  @@map("number_sequences")
}

// One background "bill the term" run (3.1), with progress for the UI.
model BillingRun {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  termId      String
  term        Term             @relation(fields: [termId], references: [id], onDelete: Cascade)
  classIds    Json             @default("[]")
  dueDate     DateTime         @db.Date
  status      BillingRunStatus @default(QUEUED)
  total       Int              @default(0)
  done        Int              @default(0)
  created     Int              @default(0)
  skipped     Int              @default(0)
  amount      Decimal          @default(0) @db.Decimal(14, 2)
  error       String?
  createdById String?
  createdBy   User?            @relation("BillingRunBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  finishedAt  DateTime?

  invoices Invoice[]

  @@index([tenantId])
  @@index([tenantId, termId, createdAt])
  @@map("billing_runs")
}

// ---------------------------------------------------------------------------
// Audit log — immutable, tenant-scoped
// ---------------------------------------------------------------------------

model AuditLog {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action         AuditAction
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  // Phase 4.0: set when a platform admin made this change while signed in as
  // `actorId` for support (no FK: audit rows are never updated).
  impersonatorId String?
  createdAt      DateTime    @default(now())

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// CSV import jobs (Phase 1.3). The uploaded file lives in `csv` (≤ 2 MB,
// CHECK in migration 0007) so it gets the same RLS protection as the rest
// of the school's data. `errors` = validation report; `importErrors` = rows
// that failed while importing. Both are arrays of { row, column, message }.
// ---------------------------------------------------------------------------

model ImportJob {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById   String?
  createdBy     User?        @relation("ImportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  kind          ImportKind
  status        ImportStatus @default(VALIDATED)
  fileName      String
  csv           String
  options       Json         @default("{}")
  totalRows     Int          @default(0)
  validRows     Int          @default(0)
  errorRows     Int          @default(0)
  processedRows Int          @default(0)
  createdRows   Int          @default(0)
  updatedRows   Int          @default(0)
  failedRows    Int          @default(0)
  errors        Json         @default("[]")
  importErrors  Json         @default("[]")
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("import_jobs")
}

// ---------------------------------------------------------------------------
// Academic settings (Phase 2, milestone 2.0)
// ---------------------------------------------------------------------------

/// A term within an academic year (Phase 2 decision: terms set per school, default three).
model Term {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String // e.g. "First term"
  order          Int
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  isCurrent      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  assessments      Assessment[]
  publications     ResultPublication[]
  reportCards      ReportCard[]
  reportCardRuns   ReportCardRun[]
  feeStructures    FeeStructure[]
  studentDiscounts StudentDiscount[]
  feeSignups       FeeSignup[]
  invoices         Invoice[]
  billingRuns      BillingRun[]

  // Also enforced in migration 0009:
  //   - partial unique index: at most one isCurrent = true per tenant
  //   - CHECK (endDate > startDate)
  @@unique([tenantId, academicYearId, name])
  @@unique([tenantId, academicYearId, order])
  @@index([tenantId])
  @@index([tenantId, academicYearId])
  @@map("terms")
}

/// One band of the school's grading scale: a total of `minScore` or more (up to the next band) earns `grade`.
model GradeBand {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  minScore Float
  grade    String // e.g. "A"
  remark   String? // e.g. "Excellent"

  // Also enforced in migration 0009: CHECK (minScore >= 0 AND minScore <= 100)
  @@unique([tenantId, minScore])
  @@unique([tenantId, grade])
  @@index([tenantId])
  @@map("grade_bands")
}

/// School-editable academic options. Deliberately separate from `Tenant.settings`,
/// which also holds plan/feature switches that only the platform may change.
model AcademicSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Show position in class on results and report cards (decision 3: off by default).
  showPosition       Boolean  @default(false)
  /// Days after which a teacher can no longer change a register (admins still can).
  attendanceEditDays Int      @default(7)
  updatedAt          DateTime @updatedAt

  // Also enforced in migration 0009: CHECK (attendanceEditDays BETWEEN 0 AND 60)
  @@map("academic_settings")
}

/// A class's results for a term are visible to parents and students only
/// while a row exists here (Phase 2.2). Published results are locked for
/// teachers; an admin unpublishes to correct them. Both are audited.
model ResultPublication {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  termId        String
  term          Term       @relation(fields: [termId], references: [id], onDelete: Cascade)
  classId       String
  class         ClassGrade @relation(fields: [classId], references: [id], onDelete: Cascade)
  publishedAt   DateTime   @default(now())
  publishedById String?
  publishedBy   User?      @relation("ResultPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, termId, classId])
  @@index([tenantId])
  @@map("result_publications")
}

enum ReportCardRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

/// One background generation of a section's report cards for a term, with progress (Phase 2.3).
model ReportCardRun {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  termId      String
  term        Term                @relation(fields: [termId], references: [id], onDelete: Cascade)
  sectionId   String
  section     Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  status      ReportCardRunStatus @default(QUEUED)
  total       Int                 @default(0)
  done        Int                 @default(0)
  error       String?
  createdById String?
  createdBy   User?               @relation("ReportCardRunBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  finishedAt  DateTime?

  @@index([tenantId])
  @@index([tenantId, termId, sectionId, createdAt])
  @@map("report_card_runs")
}

/// The school's bell schedule (Phase 2.4): one row per period, numbered in
/// time order. Breaks are shown on timetables but take no lessons.
model TimetablePeriod {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number    Int
  label     String
  startTime String // "HH:MM"
  endTime   String
  isBreak   Boolean @default(false)

  // Also enforced in migration 0013: HH:MM format, endTime > startTime, number >= 1
  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("timetable_periods")
}

// ---------------------------------------------------------------------------
// Platform console (Phase 4.0) — platform-level, never tenant-scoped. RLS is
// forced with no policy for the app role, so school sessions can't see them.
// ---------------------------------------------------------------------------

/// Everything a platform admin does. Append-only (trigger, migration 0017).
model PlatformAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  tenantId   String?
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@map("platform_audit_logs")
}

/// A platform admin signed in as a school admin for support: time-limited,
/// ended explicitly or by expiry (CHECK: at most 2 hours).
model ImpersonationSession {
  id              String    @id @default(cuid())
  platformAdminId String
  platformAdmin   User      @relation("ImpersonationBy", fields: [platformAdminId], references: [id], onDelete: Cascade)
  targetUserId    String
  targetUser      User      @relation("ImpersonationOf", fields: [targetUserId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reason          String
  startedAt       DateTime  @default(now())
  expiresAt       DateTime
  endedAt         DateTime?
  ipAddress       String?

  @@index([platformAdminId, startedAt])
  @@index([tenantId, startedAt])
  @@map("impersonation_sessions")
}
