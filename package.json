{
  "name": "educore",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "postinstall": "pnpm --filter @educore/db run generate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @educore/db exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @educore/db exec prisma migrate dev",
    "db:generate": "pnpm --filter @educore/db exec prisma generate",
    "db:seed": "pnpm --filter @educore/db exec prisma db seed",
    "db:studio": "pnpm --filter @educore/db exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
